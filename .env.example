# MongoDB connection string (local or Atlas free tier)
MONGODB_URI=mongodb://127.0.0.1:27017/malarvadi
# Password for /admin
ADMIN_PASSWORD=Malar2026
# Secret used to sign the admin session cookie
AUTH_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# DigitalOcean Spaces (image storage + CDN)
# Leave DO_SPACES_BUCKET empty to keep writing uploads to local public/uploads.
# ---------------------------------------------------------------------------
# Spaces access key pair (API -> Spaces Keys in the DO console).
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Datacenter slug of the Space, e.g. blr1, nyc3, sgp1.
DO_SPACES_REGION=blr1
# Space (bucket) name.
DO_SPACES_BUCKET=
# Optional folder inside the Space. No leading or trailing slash.
DO_SPACES_FOLDER=uploads
# Optional. Custom CDN subdomain, no trailing slash, e.g. https://cdn.malarvadi.org
# Unset, files are served from https://<bucket>.<region>.cdn.digitaloceanspaces.com
DO_SPACES_CDN_URL=
# Optional. Origin endpoint override; defaults to https://<region>.digitaloceanspaces.com
DO_SPACES_ENDPOINT=
