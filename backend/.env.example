# Copy to .env for local dev. Placeholder names only - no real values here.
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

MONGODB_URI=

# The site has exactly one admin - these credentials ARE the account.
# There is no users collection and no signup; change the password here and
# restart the backend to change the login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Any long random string. Rotating it logs the admin out.
JWT_SECRET=

# DigitalOcean Spaces (media uploads)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_CDN_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_FOLDER=
