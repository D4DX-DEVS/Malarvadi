# Copy to .env.local for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Where Next proxies /api/v1/* and where server components fetch the API.
# Server-side only - the browser never sees this, it just calls /api/v1/* on
# the same origin (see next.config.ts rewrites).
API_ORIGIN=http://localhost:4000
# CDN host allowlist goes here in a later phase (no prod config yet).
# NEXT_PUBLIC_CDN_BASE_URL=

# Social profiles shown in the header and footer. Leave one empty and its badge
# renders as an inert mark instead of a link.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_WHATSAPP_URL=
